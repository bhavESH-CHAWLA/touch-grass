# Any OpenAI-compatible endpoint serving an open-weight model.
# Local Ollama (default):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
# On Render, if Ollama runs as a private service, set this instead of LLM_BASE_URL:
# LLM_HOSTPORT=ollama:10000

# Optional Backboard API. When set, this takes priority over LLM_BASE_URL.
# Keep the API key secret; configure it in your hosting provider's environment settings.
# BACKBOARD_API_KEY=
# BACKBOARD_LLM_PROVIDER=openai
# BACKBOARD_LLM_MODEL=gpt-4o
